rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function playerPath() { return /databases/$(database)/documents/players/$(request.auth.uid); }
    function counterPath() { return /databases/$(database)/documents/meta/vanished; }

    match /meta/vanished {
      allow read: if true;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && getAfter(playerPath()).data.lastAt == request.time
        && (!exists(playerPath()) || get(playerPath()).data.lastAt < request.time - duration.value(10, 's'));
    }

    match /players/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && getAfter(counterPath()).data.count == get(counterPath()).data.count + 1;
    }

    // 証明された者(全クリした人のニックネーム)。1人1回、あとから書き換え・削除はできない(消すのは持ち主がコンソールで)
    match /clearers/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && !request.resource.data.name.matches('(?i).*(https?:|www[.]|[.](com|net|org|jp|io|me|ly|gg)).*')
        && request.resource.data.at == request.time;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
